cabal-version: 3.0
name: pawl
version: 0.2026.7.16
synopsis: Magic: the Gathering rules engine
description:
  Pawl is a Magic: the Gathering rules engine.

category: Game
license: 0BSD
maintainer: Taylor Fausak
license-file: LICENSE.txt
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  location: https://github.com/tfausak/pawl
  type: git

common library
  build-depends: base ^>=4.22.0
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

common executable
  import: library
  build-depends: pawl
  ghc-options:
    -rtsopts
    -threaded

library
  import: library
  build-depends:
    containers ^>=0.8,
    text ^>=2.1.3,
    transformers ^>=0.6.1.2,

  -- cabal-gild: discover source/library
  exposed-modules:
    Pawl
    Pawl.Action
    Pawl.Card
    Pawl.Cast
    Pawl.Decide
    Pawl.Engine
    Pawl.Game
    Pawl.Mana
    Pawl.Quantity
    Pawl.Replay
    Pawl.Sba
    Pawl.Setup
    Pawl.Stack
    Pawl.Turn
    Pawl.Type.Action
    Pawl.Type.BeginningStep
    Pawl.Type.Card
    Pawl.Type.CardType
    Pawl.Type.Color
    Pawl.Type.CombatStep
    Pawl.Type.Decider
    Pawl.Type.DecisionLog
    Pawl.Type.Departure
    Pawl.Type.EndingStep
    Pawl.Type.Game
    Pawl.Type.GameState
    Pawl.Type.Mana
    Pawl.Type.ManaCost
    Pawl.Type.ManaSymbol
    Pawl.Type.ManaType
    Pawl.Type.ManaUnit
    Pawl.Type.Object
    Pawl.Type.ObjectId
    Pawl.Type.Phase
    Pawl.Type.Player
    Pawl.Type.PlayerId
    Pawl.Type.Power
    Pawl.Type.Printing
    Pawl.Type.Program
    Pawl.Type.Prompt
    Pawl.Type.Quantity
    Pawl.Type.Response
    Pawl.Type.Result
    Pawl.Type.Sickness
    Pawl.Type.Source
    Pawl.Type.Status
    Pawl.Type.Subtype
    Pawl.Type.Supertype
    Pawl.Type.TapState
    Pawl.Type.Toughness
    Pawl.Type.TypeLine
    Pawl.Type.Zone

  hs-source-dirs: source/library

test-suite pawl-test-suite
  import: executable
  build-depends:
    containers ^>=0.8,
    random ^>=1.3.1,
    tasty ^>=1.5.4,
    tasty-hunit ^>=0.10.2,
    tasty-quickcheck ^>=0.11.1,
    text ^>=2.1.3,
    transformers ^>=0.6.1.2,

  hs-source-dirs: source/test-suite
  main-is: Main.hs
  type: exitcode-stdio-1.0

benchmark pawl-benchmark
  import: executable
  build-depends:
    tasty-bench ^>=0.5.1

  hs-source-dirs: source/benchmark
  main-is: Main.hs
  type: exitcode-stdio-1.0
