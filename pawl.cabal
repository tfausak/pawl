executable pawl
  import: executable
  ghc-options: -threaded
  hs-source-dirs: source/executable
  main-is: Main.hs

test-suite pawl-test-suite
  import: executable
  build-depends:
    containers ^>=0.8,
    directory ^>=1.3.10,
    random ^>=1.3.1,
    tasty ^>=1.5.4,
    tasty-hunit ^>=0.10.2,
    tasty-quickcheck ^>=0.11.1,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  hs-source-dirs: source/test-suite
  main-is: Main.hs
  -- cabal-gild: discover source/test-suite --exclude source/test-suite/Main.hs
  other-modules:
    Pawl.ActivateSpec
    Pawl.BindingSpec
    Pawl.Cards
    Pawl.CardSpec
    Pawl.CardsSpec
    Pawl.CastSpec
    Pawl.CodecSpec
    Pawl.ColorSpec
    Pawl.CombatSpec
    Pawl.CopySpec
    Pawl.CoreSpec
    Pawl.CostSpec
    Pawl.DamageSpec
    Pawl.DecideSpec
    Pawl.DepartureSpec
    Pawl.EventSpec
    Pawl.ExpirySpec
    Pawl.FilterSpec
    Pawl.GameSpec
    Pawl.JsonSpec
    Pawl.ManaSpec
    Pawl.ModalSpec
    Pawl.PlayerEffectSpec
    Pawl.PowerToughnessSpec
    Pawl.ProjectionSpec
    Pawl.PropertySpec
    Pawl.ReplacementSpec
    Pawl.ReplaySpec
    Pawl.ResolveSpec
    Pawl.SetupSpec
    Pawl.Support
    Pawl.TriggerSpec
    Pawl.TurnSpec

  type: exitcode-stdio-1.0

benchmark pawl-benchmark
  import: executable
  build-depends:
    containers,
    tasty-bench ^>=0.5.1,
    text ^>=2.1.3,

  hs-source-dirs: source/benchmark
  main-is: Main.hs
  type: exitcode-stdio-1.0
