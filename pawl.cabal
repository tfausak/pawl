cabal-version: 3.0
name: pawl
version: 0.2026.7.23
synopsis: Magic: the Gathering rules engine
description:
  Pawl is a Magic: the Gathering rules engine.

category: Game
license: 0BSD
maintainer: Taylor Fausak
license-file: LICENSE.txt
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  location: https://github.com/tfausak/pawl
  type: git

flag pedantic
  default: False
  manual: True

common library
  build-depends: base ^>=4.22.0
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library
  build-depends: pawl
  ghc-options: -rtsopts

library
  import: library
  build-depends:
    bytestring ^>=0.12,
    containers ^>=0.8,
    parsec ^>=3.1.18,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  -- cabal-gild: discover source/library
  exposed-modules:
    Pawl
    Pawl.Action
    Pawl.Activate
    Pawl.Binding
    Pawl.Card
    Pawl.Cast
    Pawl.Codec
    Pawl.Combat
    Pawl.Cost
    Pawl.Damage
    Pawl.Decide
    Pawl.Departure
    Pawl.Engine
