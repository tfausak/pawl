cabal-version: 3.0
-- cabal-gild: version
-- Generated with cabal-gild version 1.8.4.2
name: pawl
version: 0.2026.8.19
synopsis: Magic: the Gathering rules engine
description:
  Pawl is a Magic: the Gathering rules engine.

category: Game
license: 0BSD
maintainer: Taylor Fausak
license-file: LICENSE.txt
data-dir: data
data-files: cards/*.json
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  location: https://github.com/tfausak/pawl
  type: git

flag pedantic
  default: False
  manual: True

common library
  build-depends: base ^>=4.20.2
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library
  ghc-options: -rtsopts

-- A JSON codec for each type.
library codec
  import: library
  build-depends:
    containers ^>=0.7,
    pawl:json,
    pawl:json-codec,
    pawl:spec,
    pawl:types,
    text ^>=2.1.3,

  hs-source-dirs: source/libraries/codec
  -- cabal-gild: discover source/libraries/codec
  exposed-modules:
