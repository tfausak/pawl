cabal-version: 3.0
name: pawl
version: 0.2026.7.20
synopsis: Magic: the Gathering rules engine
description:
  Pawl is a Magic: the Gathering rules engine.

category: Game
license: 0BSD
maintainer: Taylor Fausak
license-file: LICENSE.txt
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  location: https://github.com/tfausak/pawl
  type: git

flag pedantic
  default: False
  manual: True

common library
  build-depends: base ^>=4.22.0
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library
  build-depends: pawl
  ghc-options: -rtsopts

library
  import: library
  build-depends:
    bytestring ^>=0.12,
    containers ^>=0.8,
    parsec ^>=3.1.18,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  -- cabal-gild: discover source/library
  exposed-modules:
    Pawl
    Pawl.Action
    Pawl.Activate
    Pawl.Binding
    Pawl.Card
    Pawl.Cast
    Pawl.Codec
    Pawl.Combat
    Pawl.Damage
    Pawl.Decide
    Pawl.Engine
    Pawl.Event
    Pawl.Game
    Pawl.Json
    Pawl.Mana
    Pawl.Projection
    Pawl.Quantity
    Pawl.Replay
    Pawl.Resolve
    Pawl.Sba
    Pawl.Setup
    Pawl.Stack
    Pawl.Target
    Pawl.Turn
    Pawl.Type.AbilityCost
    Pawl.Type.Action
    Pawl.Type.ActivatedAbility
    Pawl.Type.ActivePrevention
    Pawl.Type.AdditionalCost
    Pawl.Type.Affected
    Pawl.Type.AttackTarget
    Pawl.Type.BeginningStep
    Pawl.Type.Binding
    Pawl.Type.Card
    Pawl.Type.CardCriterion
    Pawl.Type.CardType
    Pawl.Type.CastingPermission
    Pawl.Type.Color
    Pawl.Type.Combat
    Pawl.Type.CombatStep
    Pawl.Type.ContinuousEffect
    Pawl.Type.CounterKind
    Pawl.Type.DamageEvent
    Pawl.Type.DamageKind
    Pawl.Type.Decider
    Pawl.Type.Decimal
    Pawl.Type.DecisionLog
    Pawl.Type.Deck
    Pawl.Type.Departure
    Pawl.Type.Duration
    Pawl.Type.Effect
    Pawl.Type.EndingStep
    Pawl.Type.Game
    Pawl.Type.GameState
    Pawl.Type.Json
    Pawl.Type.Keyword
    Pawl.Type.Layer
    Pawl.Type.Mana
    Pawl.Type.ManaCost
    Pawl.Type.ManaSymbol
    Pawl.Type.ManaType
    Pawl.Type.ManaUnit
    Pawl.Type.Modification
    Pawl.Type.Object
    Pawl.Type.ObjectId
    Pawl.Type.Phase
    Pawl.Type.Player
    Pawl.Type.PlayerId
    Pawl.Type.Power
    Pawl.Type.Prevention
    Pawl.Type.Printing
    Pawl.Type.Program
    Pawl.Type.ProjectedCharacteristics
    Pawl.Type.Prompt
    Pawl.Type.Quantity
    Pawl.Type.Recipient
    Pawl.Type.ReplacementEffect
    Pawl.Type.Response
    Pawl.Type.Result
    Pawl.Type.Sickness
    Pawl.Type.SlotName
    Pawl.Type.Source
    Pawl.Type.StaticAbility
    Pawl.Type.Status
    Pawl.Type.Subtype
    Pawl.Type.Supertype
    Pawl.Type.TapState
    Pawl.Type.TargetSpec
    Pawl.Type.Timestamp
    Pawl.Type.Toughness
    Pawl.Type.TriggerCondition
    Pawl.Type.TriggeredAbility
    Pawl.Type.TypeLine
    Pawl.Type.Zone
    Pawl.Type.ZoneChange

  hs-source-dirs: source/library

executable pawl
  import: executable
  ghc-options: -threaded
  hs-source-dirs: source/executable
  main-is: Main.hs

test-suite pawl-test-suite
  import: executable
  build-depends:
    containers ^>=0.8,
    random ^>=1.3.1,
    tasty ^>=1.5.4,
    tasty-hunit ^>=0.10.2,
    tasty-quickcheck ^>=0.11.1,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  hs-source-dirs: source/test-suite
  main-is: Main.hs
  -- cabal-gild: discover source/test-suite --exclude source/test-suite/Main.hs
  other-modules:
    Pawl.ActivateSpec
    Pawl.BindingSpec
    Pawl.Cards
    Pawl.CardSpec
    Pawl.CardsSpec
    Pawl.CastSpec
    Pawl.CodecSpec
    Pawl.CombatSpec
    Pawl.CoreSpec
    Pawl.DamageSpec
    Pawl.DecideSpec
    Pawl.EventSpec
    Pawl.GameSpec
    Pawl.JsonSpec
    Pawl.ManaSpec
    Pawl.ProjectionSpec
    Pawl.PropertySpec
    Pawl.ReplaySpec
    Pawl.ResolveSpec
    Pawl.SetupSpec
    Pawl.Support
    Pawl.TurnSpec

  type: exitcode-stdio-1.0

benchmark pawl-benchmark
  import: executable
  build-depends:
    containers,
    tasty-bench ^>=0.5.1,
    text ^>=2.1.3,

  hs-source-dirs: source/benchmark
  main-is: Main.hs
  type: exitcode-stdio-1.0
