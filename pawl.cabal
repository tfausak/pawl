cabal-version: 3.0
name: pawl
version: 0.2026.7.30
synopsis: Magic: the Gathering rules engine
description:
  Pawl is a Magic: the Gathering rules engine.

category: Game
license: 0BSD
maintainer: Taylor Fausak
license-file: LICENSE.txt
data-files: data/cards/*.json
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  location: https://github.com/tfausak/pawl
  type: git

flag pedantic
  default: False
  manual: True

common library
  build-depends: base ^>=4.22.0
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library
  build-depends: pawl
  ghc-options: -rtsopts

-- An arbitrary precision decimal number, in the spirit of the Decimal and
-- scientific packages.
library decimal
  import: library
  build-depends: pawl:spec
  -- cabal-gild: discover source/libraries/decimal
  exposed-modules:
    Pawl.Decimal
    Pawl.DecimalSpec

  hs-source-dirs: source/libraries/decimal

-- The catalog of every exception Pawl can throw, and nothing else.
library exceptions
  import: library
  build-depends:
    pawl:slug,
    text ^>=2.1.3,

  -- cabal-gild: discover source/libraries/exceptions
  exposed-modules:
    Pawl.Exceptions.CorruptCard
    Pawl.Exceptions.MisfiledCard
    Pawl.Exceptions.MissingRoot
    Pawl.Exceptions.UnknownCard

  hs-source-dirs: source/libraries/exceptions

-- Quality of life improvements for packages Pawl doesn't own, in the spirit of
-- Neil Mitchell's extra package.
library extra
  import: library
  build-depends:
    bytestring ^>=0.12.2,
    parsec ^>=3.1.18,
    pawl:spec,
    text ^>=2.1.3,

  -- cabal-gild: discover source/libraries/extra
  exposed-modules:
    Pawl.Extra.Builder
    Pawl.Extra.BuilderSpec
    Pawl.Extra.Either
    Pawl.Extra.EitherSpec
    Pawl.Extra.Int
    Pawl.Extra.Integer
    Pawl.Extra.IntegerSpec
    Pawl.Extra.IntSpec
    Pawl.Extra.Monoid
    Pawl.Extra.MonoidSpec
    Pawl.Extra.Natural
    Pawl.Extra.NaturalSpec
    Pawl.Extra.Ord
    Pawl.Extra.OrdSpec
    Pawl.Extra.Parsec
    Pawl.Extra.ParsecSpec
    Pawl.Extra.Semigroup
    Pawl.Extra.SemigroupSpec

  hs-source-dirs: source/libraries/extra

-- RFC compliant JSON types and codecs. Similar to aeson, but much simpler.
library json
  import: library
  build-depends:
    bytestring ^>=0.12.2,
    parsec ^>=3.1.18,
    pawl:decimal,
    pawl:extra,
    pawl:spec,
    text ^>=2.1.3,

  -- cabal-gild: discover source/libraries/json
  exposed-modules:
    Pawl.Json.Array
    Pawl.Json.ArraySpec
    Pawl.Json.Boolean
    Pawl.Json.BooleanSpec
    Pawl.Json.Null
    Pawl.Json.NullSpec
    Pawl.Json.Number
    Pawl.Json.NumberSpec
    Pawl.Json.Object
    Pawl.Json.ObjectSpec
    Pawl.Json.Pair
    Pawl.Json.PairSpec
    Pawl.Json.String
    Pawl.Json.StringSpec
    Pawl.Json.Value
    Pawl.Json.ValueSpec

  hs-source-dirs: source/libraries/json

-- Slugifying text: a card name in, a file-name key out.
library slug
  import: library
  build-depends:
    pawl:spec,
    text ^>=2.1.3,

  -- cabal-gild: discover source/libraries/slug
  exposed-modules:
    Pawl.Slug
    Pawl.SlugSpec

  hs-source-dirs: source/libraries/slug

-- An abstract testing interface, identical to the heck package. Base-only, which
-- is why every other sublibrary can afford to expose its specs.
library spec
  import: library
  -- cabal-gild: discover source/libraries/spec
  exposed-modules: Pawl.Spec
  hs-source-dirs: source/libraries/spec

