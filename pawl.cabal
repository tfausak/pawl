-- An arbitrary precision decimal number, in the spirit of the Decimal and
-- scientific packages.
library decimal
  import: library
  build-depends:
    pawl:spec

  hs-source-dirs: source/libraries/decimal
  -- cabal-gild: discover source/libraries/decimal
  exposed-modules:
    Pawl.Decimal
    Pawl.DecimalSpec

-- The game engine itself.
library engine
  import: library
  build-depends:
    containers ^>=0.7,
    pawl:extra,
    pawl:types,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  hs-source-dirs: source/libraries/engine
  -- cabal-gild: discover source/libraries/engine
  exposed-modules:
    Pawl.Engine.Action
    Pawl.Engine.Activate
    Pawl.Engine.ActivationRestriction
