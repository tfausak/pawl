-- The engine: the comprehensive rules, plus the codec and registry that load
-- cards as data. Belongs in a sublibrary of its own, and will get one once a
-- second consumer (a client, a CLI) exists to make the split pay.
library
  import: library
  autogen-modules: Paths_pawl
  build-depends:
    bytestring ^>=0.12,
    containers ^>=0.8,
    directory ^>=1.3.10,
    parsec ^>=3.1.18,
    pawl:decimal,
    pawl:exceptions,
    pawl:extra,
    pawl:json,
    pawl:slug,
    pawl:types,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  -- cabal-gild: discover source/library
  exposed-modules:
    Pawl
    Pawl.Action
    Pawl.Activate
    Pawl.AttackRequirement
    Pawl.Binding
    Pawl.BlockRequirement
    Pawl.Card
    Pawl.Cast
    Pawl.Codec
    Pawl.Combat
    Pawl.Condition
    Pawl.Cost
    Pawl.Count
    Pawl.Damage
    Pawl.Decide
    Pawl.Departure
    Pawl.Engine
    Pawl.Event
    Pawl.Expiry
    Pawl.Filter
    Pawl.Game
    Pawl.Json
    Pawl.Keyword
    Pawl.Mana
    Pawl.Modal
    Pawl.Monarch
    Pawl.Mulligan
    Pawl.PlayerEffect
    Pawl.Projection
    Pawl.Quantity
    Pawl.Registry
    Pawl.Replacement
    Pawl.Replay
    Pawl.Resolve
    Pawl.Sba
    Pawl.Setup
    Pawl.Stack
    Pawl.Subtype
    Pawl.Summoning
    Pawl.Target
    Pawl.Turn

  hs-source-dirs: source/library
  other-modules: Paths_pawl

executable pawl
  import: executable
  ghc-options: -threaded
  hs-source-dirs: source/executable
  main-is: Main.hs

test-suite pawl-test-suite
  import: executable
  build-depends:
    bytestring ^>=0.12,
    containers ^>=0.8,
    directory ^>=1.3.10,
    pawl:decimal,
    pawl:exceptions,
    pawl:extra,
    pawl:json,
    pawl:slug,
    pawl:spec,
    pawl:types,
    random ^>=1.3.1,
    tasty ^>=1.5.4,
    tasty-hunit ^>=0.10.2,
    tasty-quickcheck ^>=0.11.1,
    text ^>=2.1.3,
    transformers ^>=0.6.1,

  hs-source-dirs: source/test-suite
  main-is: Main.hs
  -- cabal-gild: discover source/test-suite --exclude source/test-suite/Main.hs
  other-modules:
