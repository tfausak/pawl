-- The registry provides a way to load and cache card data from disk.
library registry
  import: library
  build-depends:
    bytestring ^>=0.12.2,
    containers ^>=0.8,
    directory ^>=1.3.10,
    pawl:codec,
    pawl:exceptions,
    pawl:slug,
    pawl:types,
    text ^>=2.1.3,

  hs-source-dirs: source/libraries/registry
  autogen-modules: Paths_pawl
  other-modules: Paths_pawl
  -- cabal-gild: discover source/libraries/registry
  exposed-modules:
    Pawl.Registry

-- Converts text (card names) into slugs, which can be used for convenient file
-- names.
library slug
  import: library
  build-depends:
    pawl:spec,
    text ^>=2.1.3,

  hs-source-dirs: source/libraries/slug
  -- cabal-gild: discover source/libraries/slug
  exposed-modules:
    Pawl.Slug
    Pawl.SlugSpec

-- An abstract testing interface, identical to the heck package. Base-only,
-- which is why every other sublibrary can afford to expose its specs.
library spec
  import: library
  hs-source-dirs: source/libraries/spec
  -- cabal-gild: discover source/libraries/spec
  exposed-modules:
    Pawl.Spec

