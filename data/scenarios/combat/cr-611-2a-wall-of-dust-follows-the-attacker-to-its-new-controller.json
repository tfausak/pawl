          { "card": "Island", "label": "i1" },
          { "card": "Island", "label": "i2" },
          { "card": "Island", "label": "i3" },
          { "card": "Island", "label": "i4" },
          { "card": "Island", "label": "i5" }
        ],
        "hand": [{ "card": "Switcheroo", "label": "switch" }],
        "library": [{ "card": "Island" }, { "card": "Island" }, { "card": "Island" }, { "card": "Island" }]
      },
      {
